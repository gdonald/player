# Copy this file to .env and fill it in. .env is ignored by git. The player
# binary reads it at startup, and run.sh and deploy.sh source it.

# The login `player seed` creates. With either left empty, seeding creates no
# user, and `player user add <username>` adds one.
PLAYER_SEED_USERNAME=
PLAYER_SEED_PASSWORD=

# run.sh: the address `trunk serve` listens on.
HOST=127.0.0.1

# Optional server settings, shown with their defaults.
# DATABASE_URL=postgres://localhost/player_development
# PORT=3000
# WEB_ROOT=crates/client/dist
# RUST_LOG=info,lofty=error

# deploy.sh: the image to push, the devops checkout and the manifest in it that
# names the image, and the Kubernetes namespace and deployment to wait on.
DEPLOY_IMAGE=registry.example.com/player/player
DEVOPS_REPO=$HOME/workspace/devops
DEPLOY_MANIFEST=fleet/player/deployment.yaml
DEPLOY_NAMESPACE=player
DEPLOY_NAME=player
